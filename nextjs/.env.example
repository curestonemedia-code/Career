MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key

ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 12))"
# IMPORTANT: escape every $ as \$ — Next.js expands unescaped $VAR references
# in .env files, and bcrypt hashes are full of literal $ characters.
ADMIN_PASSWORD_HASH=\$2b\$12\$examplehashgeneratedwithbcryptjs
SESSION_SECRET=generate-with-openssl-rand-base64-32

# Resume storage via Vercel Blob. Get this from the Vercel dashboard:
# Project -> Storage -> Create Database -> Blob -> copy the read/write token.
# Leave blank to keep using the pasted-link fallback.
BLOB_READ_WRITE_TOKEN=
